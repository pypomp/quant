# use format: html: embed-resources: true
*quarto_ipynb

# For emacs users
*~

# For R users
*.RData
*.Renviron
*.Rout
*.Rhistory
renv
.renv
.renvignore
.Rprofile
renv.lock


# For Latex users
*.bbl
*.log
*.aux
*.toc
*.blg

# For Mac users
.DS_Store

# To avoid temporary files
bak
tmp
tmp*




GEMINI.md
CLAUDE.md
tests/panel_measles/R_comparison/mixed/parameter_comparison/starting_parameters.csv
tests/panel_measles/R_comparison/mixed/R_covariates.csv

# Test run outputs: the pickle/rds is a fallback, the CSV/JSON alongside it is
# the record. Keep the text, drop the binary and the logs.
tests/**/results/**/*.pkl
tests/**/results/**/logs/

# The R record. Scoped to results/R/ on purpose: R baselines are re-run rarely,
# so their *.csv.gz is worth tracking, while the Python results/{cpu,gpu}/
# equivalents turn over every run and stay ignored by the global pattern.
!tests/**/results/R/*.csv
!tests/**/results/R/*.csv.gz
!tests/**/results/R/latest.json
